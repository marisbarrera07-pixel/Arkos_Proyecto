PORT=3000
JWT_SECRET=cambia-esta-clave

# SQL Server (visible en SQL Server Management Studio 22)
# En SSMS: Connect to Server → el valor de DB_SERVER (ej. localhost\SQLEXPRESS)
# Autenticación: SQL Server Authentication, usuario DB_USER
# Luego: Bases de datos → Arkos → Tablas
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=Arkos
DB_USER=arkos
DB_PASSWORD=cambia-esta-clave
DB_ENCRYPT=false
DB_TRUST_CERT=true
