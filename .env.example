# --- Render / Azure SQL (recomendado para desplegar) ---
# En Azure Portal crea una base SQL Database, copia el servidor
# (ej. miarkos.database.windows.net) y permite el acceso desde Azure.
DB_SERVER=tu-servidor.database.windows.net
DB_PORT=1433
DB_NAME=Arkos
DB_USER=arkosadmin
DB_PASSWORD=cambia-esta-clave
DB_ENCRYPT=true
DB_TRUST_CERT=false
DB_SKIP_CREATE=true
